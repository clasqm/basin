# Path to interpreter
BSC=../bin/basin

# Path to temporary file
TMP=./sources/temp/stdout

# Path to directory with sources for tests
SRC_DIR=./sources

mkdir $SRC_DIR/temp/

# For each file *.bas in SRC_DIR
for t in `ls  $SRC_DIR/*.bas` ; do
  # Run interpreter, and put in TMP output of the program.
  # By default it will run with option --noinit-errors,
  # which is additional control of variables initialization.
  $BSC --noinit-errors $t 2>$TMP>/dev/null

  # Compare output with template
  diff $TMP $t.stdout
  res=$?

  # Print result
  if [ $res = 0 ] ; then
    echo -n "$t "
    printf "\033[32m\033[1m** TEST PASSED **\033[0m\n"
  else
    echo -n "$t "
    printf "\033[31m\033[1m** TEST FAILED **\033[0m\n"
  fi 
done

# Removing temporary directory
rm -rf $SRC_DIR/temp

exit 0
