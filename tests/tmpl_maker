# Path to interpreter
BSC=../bin/basin

# Path to directory with sources for tests
SRC_DIR=./sources

# For each file *.bas in SRC_DIR
for t in `ls $SRC_DIR/*.bas` ; do
  # Run interpreter, and put in template file output of the program
  $BSC --noinit-errors $t 2>$t.stdout>/dev/null
done
